/**
 * Environment Variables for Development
 * author: houjiazong <houjiazong@gmail.com>
 * date: 2019/08/08
 * Tips：请不要直接修改此配置文件，如有修改需求请在根目录新建.env.development.local文件修改
 */

VUE_APP_BASE_API=/api
# 可选：API 代理目标，未设置时默认 https://127.0.0.1:3000（后端未启动时会 ECONNREFUSED，可在 .env.development.local 中改为实际后端地址）
VITE_PROXY_TARGET=https://hpc.yunion.io:9443
VUE_APP_WEB_CONSOLE_PATH=http://localhost:4000/web-console/
VUE_APP_PLATFORM=cmp_public
VUE_APP_ENABLE_ICON=true
